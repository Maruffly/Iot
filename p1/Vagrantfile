# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Inception-of-Things - Part 1
# Two VMs forming a K3s cluster:
#   jmaruffyS  (Server)       -> K3s server (controller), 192.168.56.110
#   jmaruffySW (ServerWorker) -> K3s agent,               192.168.56.111

LOGIN     = "jmaruffy"
BOX       = "bento/debian-13"   # Debian 13 "trixie": latest stable Debian
SERVER_IP = "192.168.56.110"
WORKER_IP = "192.168.56.111"

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = true

  # set-default-route.sh runs with run: "always" because routes are lost at
  # reboot: it is replayed on every `vagrant up` / `vagrant reload`.

  # Shared defaults for both machines (1 CPU / 1024 MB as advised by the subject)
  config.vm.provider "virtualbox" do |vb|
    vb.cpus   = 1
    vb.memory = 1024
    vb.linked_clone = true   # clone the box disk instead of copying it: faster, lighter
  end

  # ---------------------------------------------------------------- Server
  # Defined first: Vagrant boots machines in order, so the K3s server is up
  # (and its join token available in /vagrant) before the agent is provisioned.
  config.vm.define "#{LOGIN}S", primary: true do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP
    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S"
    end
    server.vm.provision "shell", path: "scripts/set-default-route.sh", args: [SERVER_IP], run: "always"
    server.vm.provision "shell", path: "scripts/server.sh", args: [SERVER_IP]
  end

  # ---------------------------------------------------------- ServerWorker
  config.vm.define "#{LOGIN}SW" do |worker|
    worker.vm.hostname = "#{LOGIN}SW"
    worker.vm.network "private_network", ip: WORKER_IP
    worker.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}SW"
    end
    worker.vm.provision "shell", path: "scripts/set-default-route.sh", args: [WORKER_IP], run: "always"
    worker.vm.provision "shell", path: "scripts/agent.sh", args: [SERVER_IP, WORKER_IP]
  end
end
